    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "expressive-code-twoslash": "0.6.1",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.0",
