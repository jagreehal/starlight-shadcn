---
import { Icon } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';

const { data } = Astro.locals.starlightRoute.entry;
const {
	title = data.title,
	tagline: heroTagline,
	image,
	actions = [],
} = data.hero || {};

const tagline = heroTagline || data.description;
// `announcement` comes from `ExtendDocsSchema`, which Starlight's hero type does not include.
const announcement = (data.hero as { announcement?: { text: string; link: string } } | undefined)
	?.announcement;
const hasImage = Boolean(image);

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	alt: image?.alt || '',
};

// Hero images are the LCP element on splash pages: serve a width per viewport.
// They span half the row from 50rem up and the full width below.
const responsive = (img: ImageMetadata) =>
	img.format === 'svg'
		? {}
		: {
				widths: [...[480, 800, 1200, 1600].filter((w) => w < img.width), img.width],
				sizes: '(min-width: 50rem) 50vw, 100vw',
			};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;

if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

const normalizeVariant = (variant?: string) => {
	if (variant === 'primary') return 'default';
	if (variant === 'minimal') return 'ghost';
	return variant ?? 'default';
};
---

<div class="hero" data-has-image={hasImage ? '' : undefined}>
	{
		hasImage && (
			<div class="hero-image">
				{darkImage && (
					<Image
						src={darkImage}
						{...imageAttrs}
						{...responsive(darkImage)}
						class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
					/>
				)}
				{lightImage && (
					<Image src={lightImage} {...imageAttrs} {...responsive(lightImage)} class="dark:sl-hidden" />
				)}
				{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
			</div>
		)
	}

	<div class="hero-info">
		{
			announcement && (
				<a class="announcement" href={announcement.link}>
					{announcement.text}
					<Icon name="right-arrow" class="icon" />
				</a>
			)
		}
		<h1 id="_top" set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<a
							href={href}
							data-variant={normalizeVariant(variant)}
							class:list={[className]}
							{...attrs}
						>
							{text}
							{/* Starlight parses `icon` into `{ name }` (built-in) or `{ html }` (raw SVG). */}
							{icon?.name && <Icon name={icon.name} class="icon" />}
							{icon?.html && <span class="icon" set:html={icon.html} />}
						</a>
					))}
				</div>
			)
		}
	</div>
</div>

<style>
	@layer starlight-shadcn {
		.hero {
			display: grid;
			gap: 2rem;
			padding-block: 3rem 3.5rem;
		}

		/* A hero without an image centres its content. */
		.hero:not([data-has-image]) .hero-info {
			align-items: center;
			text-align: center;
		}

		.hero:not([data-has-image]) .actions {
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				padding-block: 5rem 4rem;
			}
		}

		.hero[data-has-image] {
			align-items: center;
		}

		/* Text first: the image sits right of it on desktop and below it on mobile. */
		.hero-image {
			order: 2;
		}

		@media (min-width: 50rem) {
			.hero[data-has-image] {
				grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			}
		}

		.hero-info {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		h1 {
			font-size: clamp(2.25rem, 5vw, 3rem);
			font-weight: 600;
			line-height: 1.1;
			letter-spacing: var(--sl-letter-spacing, -0.025em);
			text-wrap: balance;
		}

		.tagline {
			font-size: 1.125rem;
			line-height: 1.6;
			color: var(--muted-foreground);
			max-width: 42rem;
			text-wrap: balance;
		}

		.actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 0.5rem;
		}

		.actions a {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			height: 2.25rem;
			padding-inline: 1rem;
			font-size: 0.875rem;
			text-decoration: none;
			transition: filter 0.15s ease;
		}

		/* shadcn `<Badge variant="secondary">` as a link. */
		.announcement {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			align-self: flex-start;
			height: 1.75rem;
			padding-inline: 0.75rem;
			border-radius: 9999px;
			background-color: var(--secondary);
			color: var(--secondary-foreground);
			font-size: 0.75rem;
			font-weight: 500;
			text-decoration: none;
			transition: background-color 0.15s ease;
		}

		.hero:not([data-has-image]) .announcement {
			align-self: center;
		}

		.announcement:hover {
			background-color: var(--accent);
			color: var(--accent-foreground);
		}

		.announcement:focus-visible {
			outline: 2px solid var(--ring);
			outline-offset: 2px;
		}

		.announcement .icon {
			width: 0.875rem;
			height: 0.875rem;
		}

		.actions a:active,
		.announcement:active {
			transform: translateY(1px);
		}

		.hero-image :global(img) {
			width: 100%;
			height: auto;
		}

		.icon {
			width: 1rem;
			height: 1rem;
		}
	}
</style>
