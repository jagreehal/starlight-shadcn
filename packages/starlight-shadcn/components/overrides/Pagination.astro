---
const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

<div class="pagination-links print:hidden">
	{
		prev && (
			<a class="prev" href={prev.href} rel="prev">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m15 18-6-6 6-6" />
				</svg>
				{prev.label}
			</a>
		)
	}
	{
		next && (
			<a class="next" href={next.href} rel="next">
				{next.label}
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>
			</a>
		)
	}
</div>

<style>
	@layer starlight-shadcn {
		.pagination-links {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-top: 2rem;
			padding-top: 1rem;
			border-top: 1px solid var(--border);
		}

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			height: 2rem;
			padding-inline: 0.875rem;
			font-size: 0.875rem;
			font-weight: 500;
			text-decoration: none;
			white-space: nowrap;
		}

		a > svg {
			width: 1rem;
			height: 1rem;
		}

		.next {
			margin-left: auto;
		}
	}
</style>
