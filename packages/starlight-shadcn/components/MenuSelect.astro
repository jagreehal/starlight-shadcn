---
interface Option {
	value: string;
	label: string;
	selected?: boolean;
}

interface Props {
	label: string;
	options: Option[];
	/** Optional width hint for the trigger (e.g. `8.5rem`). */
	width?: string;
}

const { label, options, width } = Astro.props;
const selected = options.find((option) => option.selected) ?? options[0];
---

<starlight-shadcn-menu-select data-value={selected?.value ?? ''} style={width ? `--menu-select-width: ${width}` : undefined}>
	<button
		type="button"
		class="menu-select-trigger"
		aria-label={label}
		aria-haspopup="listbox"
		aria-expanded="false"
		title={label}
	>
		<span class="menu-select-value">{selected?.label ?? ''}</span>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="menu-select-caret"
			aria-hidden="true"
		>
			<path d="m6 9 6 6 6-6"></path>
		</svg>
	</button>
	<ul class="menu-select-list" role="listbox" hidden>
		{
			options.map((option) => (
				<li
					role="option"
					class="menu-select-option"
					data-value={option.value}
					aria-selected={option.selected ? 'true' : 'false'}
					tabindex="-1"
				>
					<span>{option.label}</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="menu-select-check"
						aria-hidden="true"
					>
						<path d="M20 6 9 17l-5-5" />
					</svg>
				</li>
			))
		}
	</ul>
</starlight-shadcn-menu-select>

<style>
	starlight-shadcn-menu-select {
		position: relative;
		display: inline-flex;
		--menu-select-width: auto;
	}

	.menu-select-trigger {
		all: unset;
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.375rem;
		min-width: var(--menu-select-width);
		height: 2rem;
		padding: 0 0.55rem 0 0.625rem;
		border: 1px solid var(--border);
		border-radius: calc(var(--radius) - 2px);
		background: var(--background);
		color: var(--foreground);
		font-size: 0.75rem;
		font-weight: 500;
		cursor: pointer;
		transition:
			background-color 0.15s,
			border-color 0.15s,
			color 0.15s;
	}

	.menu-select-trigger:hover {
		background: var(--muted);
	}

	.menu-select-trigger:focus-visible {
		outline: 2px solid var(--ring, var(--primary));
		outline-offset: 1px;
	}

	.menu-select-trigger[aria-expanded='true'] {
		background: var(--muted);
	}

	.menu-select-value {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.menu-select-caret {
		flex-shrink: 0;
		width: 0.875rem;
		height: 0.875rem;
		color: var(--muted-foreground);
		pointer-events: none;
	}

	.menu-select-list {
		position: absolute;
		z-index: 50;
		top: calc(100% + 0.25rem);
		inset-inline-end: 0;
		margin: 0;
		min-width: max(100%, 9rem);
		padding: 0.25rem;
		list-style: none;
		border: 1px solid var(--border);
		border-radius: calc(var(--radius) - 2px);
		background: var(--popover, var(--background));
		color: var(--popover-foreground, var(--foreground));
		box-shadow: 0 8px 24px color-mix(in oklab, var(--foreground) 12%, transparent);
	}

	.menu-select-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.375rem 0.5rem;
		border-radius: calc(var(--radius) - 4px);
		font-size: 0.8125rem;
		font-weight: 500;
		cursor: pointer;
		outline: none;
	}

	.menu-select-option:hover,
	.menu-select-option:focus-visible,
	.menu-select-option[data-active='true'] {
		background: var(--accent);
		color: var(--accent-foreground);
	}

	.menu-select-check {
		width: 0.875rem;
		height: 0.875rem;
		opacity: 0;
		flex-shrink: 0;
	}

	.menu-select-option[aria-selected='true'] .menu-select-check {
		opacity: 1;
	}
</style>

<script>
	if (!customElements.get('starlight-shadcn-menu-select')) {
		customElements.define(
			'starlight-shadcn-menu-select',
			class StarlightShadcnMenuSelect extends HTMLElement {
			#trigger: HTMLButtonElement | null = null;
			#list: HTMLUListElement | null = null;
			#options: HTMLLIElement[] = [];
			#onDocPointerDown = (event: PointerEvent) => {
				if (!this.contains(event.target as Node)) this.close();
			};
			#onDocKeyDown = (event: KeyboardEvent) => {
				if (event.key === 'Escape') {
					event.preventDefault();
					this.close();
					this.#trigger?.focus();
				}
			};

			connectedCallback() {
				this.#trigger = this.querySelector('.menu-select-trigger');
				this.#list = this.querySelector('.menu-select-list');
				this.#options = [...this.querySelectorAll<HTMLLIElement>('.menu-select-option')];
				if (!this.#trigger || !this.#list) return;

				this.#trigger.addEventListener('click', () => {
					if (this.#trigger?.getAttribute('aria-expanded') === 'true') this.close();
					else this.open();
				});

				this.#trigger.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						this.open();
						this.#focusOption(this.#selectedIndex());
					}
				});

				this.#list.addEventListener('keydown', (event) => {
					const key = event.key;
					if (key === 'ArrowDown' || key === 'ArrowUp') {
						event.preventDefault();
						const current = this.#activeIndex();
						const next =
							key === 'ArrowDown'
								? Math.min(current + 1, this.#options.length - 1)
								: Math.max(current - 1, 0);
						this.#focusOption(next);
						return;
					}
					if (key === 'Home') {
						event.preventDefault();
						this.#focusOption(0);
						return;
					}
					if (key === 'End') {
						event.preventDefault();
						this.#focusOption(this.#options.length - 1);
						return;
					}
					if (key === 'Enter' || key === ' ') {
						event.preventDefault();
						const active = this.#options[this.#activeIndex()];
						if (active) this.#choose(active);
						return;
					}
					if (key === 'Escape' || key === 'Tab') {
						this.close();
						if (key === 'Escape') this.#trigger?.focus();
					}
				});

				for (const option of this.#options) {
					option.addEventListener('click', () => this.#choose(option));
				}
			}

			get value(): string {
				return this.dataset.value ?? '';
			}

			setValue(value: string, label?: string) {
				this.dataset.value = value;
				for (const option of this.#options) {
					const selected = option.dataset.value === value;
					option.setAttribute('aria-selected', selected ? 'true' : 'false');
				}
				const valueEl = this.querySelector('.menu-select-value');
				if (valueEl && label) valueEl.textContent = label;
				else if (valueEl) {
					const match = this.#options.find((option) => option.dataset.value === value);
					const text = match?.querySelector('span')?.textContent;
					if (text) valueEl.textContent = text;
				}
			}

			open() {
				if (!this.#trigger || !this.#list) return;
				this.#trigger.setAttribute('aria-expanded', 'true');
				this.#list.hidden = false;
				this.#focusOption(this.#selectedIndex());
				document.addEventListener('pointerdown', this.#onDocPointerDown, true);
				document.addEventListener('keydown', this.#onDocKeyDown, true);
			}

			close() {
				if (!this.#trigger || !this.#list) return;
				this.#trigger.setAttribute('aria-expanded', 'false');
				this.#list.hidden = true;
				for (const option of this.#options) delete option.dataset.active;
				document.removeEventListener('pointerdown', this.#onDocPointerDown, true);
				document.removeEventListener('keydown', this.#onDocKeyDown, true);
			}

			#choose(option: HTMLLIElement) {
				const value = option.dataset.value ?? '';
				const label = option.querySelector('span')?.textContent ?? '';
				this.setValue(value, label);
				this.close();
				this.#trigger?.focus();
				this.dispatchEvent(
					new CustomEvent('menu-select-change', {
						bubbles: true,
						detail: { value, label },
					}),
				);
			}

			#selectedIndex() {
				const index = this.#options.findIndex(
					(option) => option.getAttribute('aria-selected') === 'true',
				);
				return index >= 0 ? index : 0;
			}

			#activeIndex() {
				const index = this.#options.findIndex((option) => option.dataset.active === 'true');
				return index >= 0 ? index : this.#selectedIndex();
			}

			#focusOption(index: number) {
				for (const [i, option] of this.#options.entries()) {
					if (i === index) {
						option.dataset.active = 'true';
						option.focus();
					} else {
						delete option.dataset.active;
					}
				}
			}
		},
		);
	}
</script>
