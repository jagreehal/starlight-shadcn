---
import { config } from 'virtual:starlight-shadcn/config';

const { editUrl, entry } = Astro.locals.starlightRoute;
const enabled = config.pageActions.enabled;
const body = entry.body ?? '';
const { title, description } = entry.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const stripped =
	base && pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname;
const path = !stripped || stripped === '/' ? '/index' : stripped;
const markdownTemplate = config.pageActions.markdownUrl;
const markdownUrl = markdownTemplate
	? markdownTemplate.replaceAll('{base}', base).replaceAll('{path}', path)
	: undefined;

const hasInlineBody = Boolean(body.trim());
const showCopy = Boolean(markdownUrl) || hasInlineBody;
// Stored in a <template> so page bodies never sit inside a host <script>.
const inlineMarkdown =
	!markdownUrl && hasInlineBody
		? [
				'---',
				`title: ${JSON.stringify(title)}`,
				...(description ? [`description: ${JSON.stringify(description)}`] : []),
				'---',
				'',
				body,
			].join('\n')
		: undefined;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const prompt = `Read ${pageUrl}, I want to ask questions about it.`;

const t = Astro.locals.t;

const openLinks = [
	editUrl && { href: editUrl, label: t('starlightShadcn.openInGitHub'), external: true },
	markdownUrl && {
		href: markdownUrl,
		label: t('starlightShadcn.viewAsMarkdown'),
		external: false,
	},
	{
		href: `https://chatgpt.com/?${new URLSearchParams({ hints: 'search', q: prompt })}`,
		label: t('starlightShadcn.openInChatGPT'),
		external: true,
	},
	{
		href: `https://claude.ai/new?${new URLSearchParams({ q: prompt })}`,
		label: t('starlightShadcn.openInClaude'),
		external: true,
	},
	{
		href: `https://cursor.com/link/prompt?${new URLSearchParams({ text: prompt })}`,
		label: t('starlightShadcn.openInCursor'),
		external: true,
	},
].filter(Boolean) as { href: string; label: string; external: boolean }[];
---

{
	enabled && (
		<starlight-shadcn-page-actions
			class="shadcn-page-actions print:hidden"
			data-copied={t('starlightShadcn.copyMarkdownSuccess')}
			data-failed-label={t('starlightShadcn.copyMarkdownFailed')}
			data-failed-status={t('starlightShadcn.copyMarkdownFailedStatus')}
		>
			{showCopy && (
				<button
					type="button"
					class="page-action-btn"
					data-markdown-url={markdownUrl}
					data-copy-markdown
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="icon-copy"
						aria-hidden="true"
					>
						<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
						<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
					</svg>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="icon-check"
						aria-hidden="true"
						hidden
					>
						<path d="M20 6 9 17l-5-5" />
					</svg>
					<span data-copy-label>{t('starlightShadcn.copyMarkdown')}</span>
				</button>
			)}
			{inlineMarkdown && (
				<template data-markdown-inline>{inlineMarkdown}</template>
			)}
			{/* The icon swap is invisible to screen readers, so success and failure
			    are announced here instead. */}
			{showCopy && <span class="sr-only" role="status" aria-live="polite" data-copy-status />}
			{openLinks.length > 0 && (
				<details class="page-action-open">
					<summary class="page-action-btn">
						{t('starlightShadcn.open')}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="m6 9 6 6 6-6" />
						</svg>
					</summary>
					<ul class="page-action-menu">
						{openLinks.map((link) => (
							<li>
								<a
									href={link.href}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noreferrer noopener' : undefined}
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</details>
			)}
		</starlight-shadcn-page-actions>
	)
}

{
	enabled && (
		<script>
			const cache = new Map<string, Promise<string>>();

			class StarlightShadcnPageActions extends HTMLElement {
				#resetTimer = 0;

				disconnectedCallback() {
					window.clearTimeout(this.#resetTimer);
				}

				connectedCallback() {
					const button = this.querySelector<HTMLButtonElement>('[data-copy-markdown]');
					if (!button) return;
					button.addEventListener('click', async () => {
						const url = button.dataset.markdownUrl;
						const inline = this.querySelector<HTMLTemplateElement>('[data-markdown-inline]');
						if (!url && !inline) return;
						button.disabled = true;
						const label = button.querySelector<HTMLElement>('[data-copy-label]');
						const status = this.querySelector<HTMLElement>('[data-copy-status]');
						const copy = button.querySelector<HTMLElement>('.icon-copy');
						const check = button.querySelector<HTMLElement>('.icon-check');
						const original = label?.textContent ?? '';
						window.clearTimeout(this.#resetTimer);

						try {
							let text: string;
							if (url) {
								let promise = cache.get(url);
								if (!promise) {
									promise = fetch(url).then(async (res) => {
										if (!res.ok) throw new Error(`Failed to fetch markdown (${res.status})`);
										return res.text();
									});
									cache.set(url, promise);
								}
								text = await promise;
							} else {
								text = inline!.content.textContent ?? '';
							}
							// Rejects on insecure origins and when permission is denied.
							await navigator.clipboard.writeText(text);
							if (copy) copy.hidden = true;
							if (check) check.hidden = false;
							if (status) status.textContent = this.dataset.copied ?? '';
						} catch {
							if (url) cache.delete(url);
							// Silent failure looks like a dead button — say so in both channels.
							if (label) label.textContent = this.dataset.failedLabel ?? '';
							if (status) status.textContent = this.dataset.failedStatus ?? '';
						} finally {
							button.disabled = false;
							this.#resetTimer = window.setTimeout(() => {
								if (copy) copy.hidden = false;
								if (check) check.hidden = true;
								if (label) label.textContent = original;
								if (status) status.textContent = '';
							}, 1500);
						}
					});
				}
			}

			if (!customElements.get('starlight-shadcn-page-actions')) {
				customElements.define('starlight-shadcn-page-actions', StarlightShadcnPageActions);
			}
		</script>
	)
}

<style>
	@layer starlight-shadcn {
		.shadcn-page-actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.5rem;
			flex-shrink: 0;
		}

		.page-action-btn {
			all: unset;
			box-sizing: border-box;
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			height: 2rem;
			padding-inline: 0.75rem;
			border: 1px solid var(--border);
			border-radius: calc(var(--radius) - 2px);
			background-color: var(--secondary);
			color: var(--secondary-foreground);
			font-size: 0.8125rem;
			font-weight: 500;
			cursor: pointer;
		}

		.page-action-btn:hover {
			background-color: var(--muted);
		}

		.page-action-btn:disabled {
			opacity: 0.6;
			cursor: wait;
		}

		.page-action-open {
			position: relative;
		}

		.page-action-open > summary {
			list-style: none;
		}

		.page-action-open > summary::-webkit-details-marker {
			display: none;
		}

		.page-action-menu {
			position: absolute;
			inset-block-start: calc(100% + 0.25rem);
			inset-inline-end: 0;
			z-index: 20;
			min-width: 12rem;
			margin: 0;
			padding: 0.25rem;
			list-style: none;
			border: 1px solid var(--border);
			border-radius: calc(var(--radius) - 2px);
			background-color: var(--popover);
			color: var(--popover-foreground);
			box-shadow: var(--sl-shadow-md);
		}

		.page-action-menu a {
			display: block;
			padding: 0.375rem 0.5rem;
			border-radius: calc(var(--radius) - 4px);
			color: inherit;
			font-size: 0.8125rem;
			text-decoration: none;
		}

		.page-action-menu a:hover {
			background-color: var(--muted);
		}
	}
</style>
