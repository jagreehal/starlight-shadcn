{
  "name": "starlight-shadcn",
  "version": "0.1.0",
  "type": "module",
  "description": "shadcn + React Aria theme for Starlight on Astro 7",
  "author": "jagreehal",
  "license": "MIT",
  "homepage": "https://github.com/jagreehal/starlight-shadcn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/starlight-shadcn.git",
    "directory": "packages/starlight-shadcn"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/starlight-shadcn/issues"
  },
  "keywords": [
    "astro",
    "starlight",
    "shadcn",
    "react-aria",
    "theme",
    "documentation"
  ],
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema.ts",
    "./overrides": "./core/config/overrides.ts",
    "./styles/layers": "./styles/layers.css",
    "./styles/theme": "./styles/theme.css",
    "./styles/base": "./styles/base.css",
    "./styles/components": "./styles/components.css",
    "./styles/fonts": "./styles/fonts.css",
    "./components/overrides/*": "./components/overrides/*",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "core",
    "styles",
    "index.ts",
    "schema.ts",
    "virtual.d.ts"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.4",
    "astro": "^7",
    "mermaid": ">=11"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7",
    "mermaid": "11.17.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  }
